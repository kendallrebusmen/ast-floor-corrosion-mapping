[Feature Method]
Method0=Visual
Method1=Ultrasonic
Method2=Eddy Current
Method3=Coating Test
Method4=TBit

  
[WCT]
; WCT == Wall thickness Calculation Tool 
; WCT berechnet die Wandstärke bezogen auf eine Tankbodenplatte und speichert sie in *.IB5 Dateien 
fWtMMInCount=10.0

[CWT]
; CWT Calculated Wall Thickness
; CWT wird  Online berechnet, in LineView  dargestellt und in IB4- Dateien gespeichert.
; Nach der Normierung mit CWT = (Count[i] - Offset[i]) * Gain[i]  werden Bereiche
; mit CWT < fWtMarkThreshold gelb eingefärbt
fWtMarkThreshold=5.0

[Desktop]
strActiveToolID=T51
